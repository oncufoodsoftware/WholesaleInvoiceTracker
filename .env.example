# ============================================================
# Environment Variables — WholesaleInvoiceTracker
# Copy this file to .env and fill in your values.
# On Plesk, set these via: Domains > Node.js > Environment Variables
# ============================================================

# -----------------------------------------------------------
# Database (required)
# PostgreSQL connection string.
# Example for Neon: postgresql://user:pass@host/dbname?sslmode=require
# Example for local PG: postgresql://user:pass@localhost:5432/dbname
# -----------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------
# Session secret (strongly recommended)
# Used to sign session cookies. Use a long random string (32+ chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------
SESSION_SECRET=change-this-to-a-long-random-secret-string

# -----------------------------------------------------------
# Node environment (required for production)
# Set to "production" on Plesk.
# -----------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------
# Port (optional)
# The port the application listens on.
# Plesk typically sets this automatically via the PORT env var.
# Defaults to 5000 if not set.
# -----------------------------------------------------------
# PORT=5000

# -----------------------------------------------------------
# OpenAI API key (optional)
# Required only if AI-powered features are used.
# -----------------------------------------------------------
# OPENAI_API_KEY=sk-...
